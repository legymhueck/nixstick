{
  config,
  lib,
  options,
  pkgs,
  inputs,
  vars,
  ...
}:
let
  # Unfree applications: list the pname of every unfree package installed
  # from common/apps.nix. Names are as returned by lib.getName (the pname);
  # VS Code extensions are named "vscode-extension-<publisher>-<name>" with
  # the publisher spelled as in the marketplace.
  allowedUnfreePkgs = [
    "claude-code"
    "copilot-language-server"
    "github-copilot-cli"
    "veracrypt"
    "vscode-extension-anthropic-claude-code"
  ];
in
{
  # Base system (UEFI, LUKS2 + Btrfs) on a USB stick that boots on any x86 PC.
  # Hardware support is in hardware-portable.nix, the rules for foreign PCs
  # (no traces in firmware, TPM, clock, disks) in traceless.nix, the YubiKey in
  # yubikey.nix, the desktop in nixos-mango/.
  imports = [
    ./calendar.nix
    ./printing.nix
    ./traceless.nix
    ./yubikey.nix
  ];

  config = {
    system.stateVersion = "26.05"; # use the value generated by the installer, never bump it

    # --- nix: pinned, reproducible, self-cleaning ---
    nix.settings.experimental-features = [
      "nix-command"
      "flakes"
    ];
    # `nix shell nixpkgs#foo` and <nixpkgs> use the same revision as the system.
    nix.registry.nixpkgs.flake = inputs.nixpkgs;
    nix.nixPath = [ "nixpkgs=${inputs.nixpkgs}" ];
    # No nix.optimise.automatic: rewriting the store for dedup costs flash wear.
    # The main repo's Cachix cache: its CI builds Mango for the main repo's
    # flake.lock. `lock-sync` pins nixpkgs and Mango to that lock, so the stick
    # downloads Mango instead of compiling it.
    nix.settings.extra-substituters = [ "https://nixbox-m.cachix.org" ];
    nix.settings.extra-trusted-public-keys = [
      "nixbox-m.cachix.org-1:u4KOLno2/9lxr+sHXKaB9iNYKZPav9OVTTEUOhqAf6E="
    ];
    # Keep an explicit unfree allowlist instead of allowing the entire package
    # set (see allowedUnfreePkgs above).
    nixpkgs.config.allowUnfreePredicate = pkg: builtins.elem (lib.getName pkg) allowedUnfreePkgs;
    # The one local package, hylki: a copy of the main repo's pkgs/hylki with the
    # same source pin, so it is downloaded from nixbox-m, never built here.
    nixpkgs.overlays = [
      (final: _: { hylki = final.callPackage ../pkgs/hylki/package.nix { src = inputs.hylki-src; }; })
    ];
    # nh: nicer rebuilds (`nh os switch`) and the weekly garbage collection
    # (replaces nix.gc, they must not both be enabled).
    programs.nh = {
      enable = true;
      flake = "/home/${vars.user}/nixos";
      clean = {
        enable = true;
        dates = "weekly";
        extraArgs = "--keep-since 14d --keep 5";
      };
    };

    # --- boot, LUKS, Btrfs, zram ---
    boot.loader.systemd-boot = {
      enable = true;
      editor = false; # no kernel-parameter editing from the boot menu
      configurationLimit = 10;
    };
    boot.loader.timeout = 3;
    # No boot entries in the PC's firmware: traceless.nix.
    boot.initrd.luks.devices.cryptroot = {
      # merged with the generated entry
      allowDiscards = true; # TRIM through LUKS (leaks which blocks are free)
    };

    fileSystems = lib.mkMerge [
      (lib.genAttrs vars.btrfsMounts (_: {
        options = [
          "compress=zstd"
          "noatime"
        ];
      })) # merged with generated subvol=
      { "/var/log".neededForBoot = true; }
    ];

    # Refuse to activate a configuration whose disks are not attached: the
    # hardware module of another stick (wrong hosts/<name>, `nh os switch -H`)
    # would otherwise hang on mounting /boot and leave an unbootable entry.
    system.preSwitchChecks.disks-present =
      let
        devices = lib.unique (
          lib.filter (d: d != null && lib.hasPrefix "/dev/disk/" d) (
            map (fs: fs.device) (lib.attrValues config.fileSystems)
            ++ map (l: l.device) (lib.attrValues config.boot.initrd.luks.devices)
          )
        );
      in
      ''
        for d in ${lib.escapeShellArgs devices}; do
          if [ ! -e "$d" ]; then
            echo "$d does not exist: this configuration belongs to another stick (this is $(cat /proc/sys/kernel/hostname), see hosts/)." >&2
            exit 1
          fi
        done
      '';
    services.btrfs.autoScrub.enable = true;
    services.fstrim.enable = true;

    # No swap file: zram is enough and spares the flash.
    # (The installer only uses a temporary swap file while it builds.)
    # No hibernation without disk swap.
    zramSwap = {
      enable = true;
      algorithm = "zstd";
      memoryPercent = 50;
    };
    boot.kernel.sysctl = {
      "vm.swappiness" = 180;
      "vm.page-cluster" = 0;
    }; # zram tuning

    # --- less flash wear: logs and /tmp in RAM ---
    # The journal is lost at reboot; `journalctl -b` still shows the current boot.
    services.journald.settings.Journal.Storage = "volatile"; # capped at 10 % of /run by default
    boot.tmp.useTmpfs = true;
    # Nix builds stay on disk, a large build would not fit into a RAM /tmp.
    systemd.services.nix-daemon.environment.TMPDIR = "/var/tmp";

    # --- basics: English UI, German formats ---
    # networking.hostName is set by the flake from hosts/<hostname>/.
    networking.networkmanager.enable = true;
    time.timeZone = "Europe/Berlin";
    # The stick boots almost only on Windows PCs whose clock setting cannot be
    # changed; Windows reads the hardware clock as local time. With UTC here,
    # NixOS would leave those PCs' clocks off by one or two hours.
    time.hardwareClockInLocalTime = true;
    i18n.defaultLocale = "en_US.UTF-8";
    i18n.extraLocaleSettings = lib.genAttrs [
      "LC_ADDRESS"
      "LC_IDENTIFICATION"
      "LC_MEASUREMENT"
      "LC_MONETARY"
      "LC_NAME"
      "LC_NUMERIC"
      "LC_PAPER"
      "LC_TELEPHONE"
      "LC_TIME"
    ] (_: "de_DE.UTF-8");
    console.keyMap = "de-latin1";
    console.earlySetup = true; # German layout already at the LUKS passphrase prompt

    users.users.${vars.user} = {
      isNormalUser = true;
      extraGroups = [
        "wheel"
        "networkmanager"
        "video"
        "audio"
        "i2c" # ddcutil: brightness of external monitors (DDC/CI)
      ];
    };
    # Root login is disabled; use sudo from user "m" (wheel).
    users.users.root.hashedPassword = "!";
    # VeraCrypt mounts via `sudo -S <its binary> --core-service` (the path from
    # /proc/self/exe: nixpkgs' wrapProgram makes that bin/.veracrypt-wrapped,
    # not bin/veracrypt) after probing `sudo -n true`;
    # it asks for the password only if that probe fails. Both run without a
    # password here. Trade-off: anything running as the user can drive the
    # root core service (mount any volume anywhere) without a password.
    # (Same rule as in the main repo nixos.)
    security.sudo.extraRules = [
      {
        users = [ vars.user ];
        commands = [
          {
            command = "${pkgs.veracrypt}/bin/.veracrypt-wrapped --core-service";
            options = [ "NOPASSWD" ];
          }
          {
            command = "/run/current-system/sw/bin/true";
            options = [ "NOPASSWD" ];
          }
        ];
      }
    ];

    # --- services ---
    services.tailscale = {
      enable = true;
      useRoutingFeatures = "client"; # exit nodes / subnet routes
      # The user may run `tailscale set/up/down` without sudo (exit node).
      extraSetFlags = [ "--operator=${vars.user}" ];
    };
    networking.firewall.checkReversePath = "loose"; # needed for Tailscale exit nodes
    # ddcutil (Noctalia brightness for external monitors): i2c-dev module and
    # "i2c" group. DDC/CI only changes the monitor's own brightness setting when
    # asked to, nothing on the PC (common/traceless.nix).
    hardware.i2c.enable = true;
    services.hardware.bolt.enable = true; # Thunderbolt
    # A keyboard behind a Thunderbolt device (the monitor's USB hub) is not
    # there at the LUKS prompt: with security level "user" the kernel opens the
    # PCIe tunnel only after authorization, and boltd starts after the root
    # disk is unlocked. The initrd authorizes the devices from vars.nix itself
    # (by unique_id, not every device: DMA). Authorization lives only in the
    # controller's RAM until unplug/power-off, nothing is stored on a foreign
    # PC (traceless.nix).
    boot.initrd.services.udev.rules = lib.concatMapStrings (d: ''
      ACTION=="add", SUBSYSTEM=="thunderbolt", ATTR{unique_id}=="${d.unique_id}", ATTR{authorized}=="0", ATTR{authorized}="1"
    '') vars.thunderboltInitrd;
    services.udisks2.enable = true; # mounting drives (udiskie, file manager)

    # No snapper: hourly snapshots wear out a stick; the repos live on GitHub.

    # --- desktop plumbing ---
    programs.dconf.enable = true;
    services.pipewire = {
      enable = true;
      alsa.enable = true;
      pulse.enable = true;
      # Bluetooth headsets stay in A2DP (AAC) when an app opens a microphone;
      # the PC's mic is used instead. Headset mic only via a manual profile
      # switch to HFP (Noctalia/pwvucontrol). Avoids the muffled phone sound
      # and dropouts at the switch (e.g. Claude voice mode).
      wireplumber.extraConfig."51-bluetooth-no-autoswitch"."wireplumber.settings" = {
        "bluetooth.autoswitch-to-headset-profile" = false;
      };
    };
    security.rtkit.enable = true;
    hardware.bluetooth.enable = true;
    services.power-profiles-daemon.enable = true;
    services.upower.enable = true;
    environment.sessionVariables = {
      NIXOS_OZONE_WL = "1"; # Electron/Chromium on Wayland
    };
    # Prebuilt Linux programs (uv-managed Python 3.14, pip/uv wheels such as
    # pygame-ce, binaries that agents or npx download) expect a normal Linux
    # loader. nix-ld provides it plus these libraries; the defaults
    # (zlib, openssl, libstdc++, ...) stay. The extras are what SDL/pygame and
    # manylinux wheels load at run time.
    programs.nix-ld = {
      enable = true;
      libraries =
        options.programs.nix-ld.libraries.default
        ++ (with pkgs; [
          alsa-lib
          fontconfig
          freetype
          glib
          libdecor
          libGL
          libpulseaudio
          libx11
          libxcursor
          libxext
          libxi
          libxkbcommon
          libxrandr
          libxrender
          wayland
        ]);
    };

    fonts.packages = with pkgs; [
      # Print layout of the repo unterricht (_vorlagen/typst): Carlito for
      # text, JetBrains Mono NL for code (the package has the NL variants).
      carlito
      # Source Sans 3: close to Carlito, a little wider; covers ✔ ✘ ″ → too,
      # so it needs no fallback font (compared 2026-11-22).
      source-sans
      jetbrains-mono
      nerd-fonts.jetbrains-mono
      noto-fonts
      noto-fonts-color-emoji
    ];
    hardware.graphics.enable = true;

    # --- essential system-wide command line tools (also for sudo) ---
    # Applications (free and unfree) have their single spot in common/apps.nix.
    environment.systemPackages = with pkgs; [
      acpi
      alsa-utils
      bind # dig
      brightnessctl
      ddcutil # Noctalia: brightness of external monitors over DDC/CI
      btrfs-progs
      compsize
      cryptsetup
      dosfstools
      git
      vim # default editor, also with sudo
      jq
      man-db
      mc # file manager for the terminal
      openssh
      smartmontools
      usbutils
      xdg-utils
    ];
  };
}
