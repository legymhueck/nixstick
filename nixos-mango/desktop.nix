{
  config,
  lib,
  inputs,
  pkgs,
  osConfig,
  ...
}:

let
  # Defined once in configuration.nix (nixbox.cursor)
  cursorTheme = osConfig.nixbox.cursor.theme;
  cursorSize = osConfig.nixbox.cursor.size;
in

# Mango (compositor) + Noctalia (shell) + theming. Home Manager module.
{
  imports = [
    inputs.mango.hmModules.mango
    inputs.noctalia.homeModules.default
  ];

  # Desktop plumbing for Mango and Noctalia (applications live in ../common/apps.nix):
  # - adwaita: GTK icons; breeze-dark: the icon theme Noctalia resolves
  #   launcher icons from (set via gtk.iconTheme below)
  # - trash-cli: free space trash for the file manager
  home.packages = with pkgs; [
    adwaita-icon-theme
    kdePackages.breeze-icons
    trash-cli
  ];

  # Drives: udiskie in the Noctalia tray (appindicator). Clicking it mounts,
  # unlocks (LUKS: passphrase dialog), unmounts and ejects a USB drive.
  # Nothing is mounted automatically, and the PC's internal disks are not
  # shown at all (common/traceless.nix).
  services.udiskie = {
    enable = true;
    automount = false;
    notify = true;
    tray = "auto";
    settings.program_options = {
      appindicator = true;
      file_manager = "doublecmd";
    };
  };

  # Let Noctalia generate GTK and Qt theme/config files instead of pinning
  # them from dotfiles so the build is self-contained. Keep only the
  # `xdg-desktop-portal` config pinned which is not generated by Noctalia.
  xdg.configFile = {
    "xdg-desktop-portal/mango-portals.conf".source =
      ../dotfiles/config/.config/xdg-desktop-portal/mango-portals.conf;
  };

  # GTK3 on Wayland (e.g. LibreOffice's gtk3 plugin) takes these from GSettings, not settings.ini
  dconf.settings."org/gnome/desktop/interface" = {
    cursor-theme = cursorTheme;
    cursor-size = cursorSize;
    gtk-theme = "adw-gtk3-dark";
    icon-theme = "breeze-dark";
    color-scheme = "prefer-dark";
  };

  # Noctalia resolves launcher icons from GTK's active icon theme. Keep the
  # GTK settings.ini in sync with GSettings so the resolver sees Breeze Dark.
  # The cursor is needed there too: GTK reads GSettings only on Wayland, so
  # X11 clients on XWayland (pCloud's Electron) take it from settings.ini.
  gtk = {
    enable = true;
    iconTheme = {
      name = "breeze-dark";
      package = pkgs.kdePackages.breeze-icons;
    };
    cursorTheme = {
      name = cursorTheme;
      size = cursorSize;
    };
  };

  programs.noctalia = {
    enable = true;

    settings = {
      theme = {
        mode = "dark";
        source = "wallpaper";
      };

      wallpaper = {
        directory = "${config.home.homeDirectory}/nixos/wallpapers";
        automation = {
          enabled = true;
          interval_seconds = 1800;
          order = "random";
        };
      };

      shell.animation.enabled = false;
      lockscreen.transition = [ ];
      lockscreen.fingerprint = true;
      # Enter with an empty field starts PAM, which then waits for a touch of
      # the YubiKey (common/yubikey.nix); without a key the empty password fails.
      lockscreen.allow_empty_password = true;

      bar.default = {
        background_opacity = 1.0;
        center = [
          "workspaces"
          "Spacer_2"
          "media"
        ];
        end = [
          "tray"
          "Spacer_2"
          "notifications"
          "clipboard"
          "recorder"
          "Spacer_2"
          "network"
          "bluetooth"
          "volume"
          "brightness"
          "battery"
          "Spacer_2"
          "date"
          "clock"
          "Spacer_2"
          "session"
          "Spacer"
        ];
        margin_edge = 0;
        margin_ends = 0;
        radius_bottom_left = 0;
        radius_bottom_right = 0;
        radius_top_left = 0;
        radius_top_right = 0;
        start = [
          "Spacer"
          "launcher"
          "Spacer_2"
          "active_window"
        ];
        thickness = 40;
      };

      idle.behavior_order = [
        "lock"
        "screen-off"
        "lock-and-suspend"
      ];
      idle.behavior.lock = {
        action = "lock";
        enabled = true;
        timeout = 600.0;
      };
      idle.behavior.screen-off = {
        action = "screen-off";
        enabled = true;
        timeout = 300.0;
      };
      idle.behavior.lock-and-suspend = {
        action = "suspend";
        enabled = true;
        lock_before_suspend = true;
        timeout = 900.0;
      };

      lockscreen_widgets = {
        enabled = false;
        schema_version = 2;
        widget_order = [ ];
        grid = {
          cell_size = 16;
          major_interval = 4;
          visible = true;
        };
      };

      plugin_settings."noctalia/screen_recorder".restore_portal = false;
      plugins = {
        auto_update = "none";
        enabled = [
          "noctalia/screen_recorder"
          "noctalia/wallhaven"
        ];
        source = [
          {
            kind = "path";
            location = "${inputs.noctalia_official_plugins}";
            name = "official";
          }
          {
            kind = "path";
            location = "${inputs.noctalia_community_plugins}";
            name = "community";
          }
        ];
      };

      shell.polkit_agent = true;
      shell.settings_show_advanced = true;
      # Let Noctalia generate the GTK/Qt theme files (gtk3, gtk4, qt)
      # so the build produces its theme artifacts without external pins.
      theme.templates = {
        enable_builtin_templates = true;
        builtin_ids = [
          "foot"
          "gtk3"
          "gtk4"
          "kcolorscheme"
          "mango"
          "qt"
        ];
      };
      widget.Spacer = {
        length = 10;
        type = "spacer";
      };
      widget.Spacer_2.type = "spacer";
      widget.date.format = "{:%a %d %b -}";
      widget.launcher.scale = 1.45;
      widget.network.show_label = false;
      widget.recorder.type = "noctalia/screen_recorder:recorder";
      widget.workspaces = {
        anchor = true;
        show_labels = false;
      };
    };
  };

  wayland.windowManager.mango = {
    enable = true;

    settings = {
      exec_once = "noctalia";
      xkb_rules_layout = "de";
      mouse_accel_profile = 1;
      mouse_accel_speed = 0.1;

      animations = 0;
      layer_animations = 0;

      gap_inner_horizontal = 0;
      gap_inner_vertical = 0;
      gap_outer_horizontal = 0;
      gap_outer_vertical = 0;
      border_px = 1;
      border_radius = 0;
      no_radius_when_single = 1;
      focused_opacity = 1.0;
      unfocused_opacity = 1.0;
      scratchpad_width_ratio = 0.8;
      scratchpad_height_ratio = 0.9;
      cursor_theme = cursorTheme;
      cursor_size = cursorSize;
      blur = 0;
      blur_layer = 0;
      shadows = 0;
      layer_shadows = 0;
      tag_rule = lib.genList (n: "id:${toString n}, layout_name:scroller") 9;
      scroller_structs = 0;
      scroller_default_proportion = 1.0;
      scroller_focus_center = 0;
      scroller_prefer_center = 0;
      scroller_prefer_overspread = 1;
      edge_scroller_pointer_focus = 1;
      scroller_ignore_proportion_single = 0;
      scroller_default_proportion_single = 1.0;
      scroller_proportion_preset = "0.5, 0.8, 1.0";
      new_is_master = 1;
      default_master_factor = 0.55;
      default_master_count = 1;
      smart_gaps = 0;
      mousebind = [
        "SUPER,btn_left,moveresize,curmove"
        "NONE,btn_middle,togglemaximizescreen,0"
        "SUPER,btn_right,moveresize,curresize"
      ];
      layer_rule = [ "no_animation:1, no_blur:1, layer_name:selection" ];
      allow_tearing = 2;
      sync_obj_enable = 1;
      drag_tile_to_tile = 1;

      bind = [
        "SUPER,d,spawn,noctalia msg panel-toggle launcher"
        "SUPER,s,spawn,noctalia msg panel-toggle control-center"
        "SUPER+SHIFT,s,spawn,noctalia msg settings-toggle"
        "SUPER,comma,spawn,noctalia msg settings-toggle"
        "SUPER,Return,spawn,foot"
        "SUPER+SHIFT,Return,spawn,doublecmd"
        "SUPER,w,spawn,firefox"
        "SUPER,q,killclient,"
        "SUPER+CTRL,q,quit"
        "SUPER+SHIFT,w,spawn,noctalia msg panel-toggle noctalia/wallhaven:browser"
        "SUPER+SHIFT,c,spawn,noctalia msg panel-toggle clipboard"
        "SUPER+SHIFT,q,spawn,noctalia msg panel-toggle session"
        # Lock at once (leaving a foreign PC for a moment)
        "SUPER,l,spawn,noctalia msg session lock"
        "SUPER+SHIFT,b,spawn,noctalia msg bar-toggle"
        "SUPER,p,spawn,noctalia msg screenshot-region"
        "SUPER+SHIFT,p,spawn,noctalia msg screenshot-fullscreen"
        "SUPER+ALT,p,spawn,noctalia msg screenshot-fullscreen all"
        "SUPER,r,reload_config"
        "SUPER,g,toggleglobal,"
        "ALT,Tab,toggleoverview"
        "SUPER,v,togglefloating,"
        "SUPER,c,centerwin"
        "SUPER,f,togglemaximizescreen"
        "SUPER+SHIFT,f,togglefullscreen"
        "SUPER+ALT,f,togglefakefullscreen"
        "SUPER,i,minimized"
        "SUPER,o,toggleoverlay"
        "SUPER+SHIFT,I,restore_minimized"
        "SUPER,z,toggle_scratchpad"
        "SUPER+SHIFT,e,set_proportion,1.0"
        "SUPER,x,set_proportion,0.5"
        "SUPER,n,switch_layout"
        "SUPER+ALT,s,setlayout,scroller"
        "SUPER,Tab,focusstack,next"
        "SUPER,Left,focusdir,left"
        "SUPER,Right,focusdir,right"
        "SUPER,Up,focusdir,up"
        "SUPER,Down,focusdir,down"
        "SUPER+SHIFT,Left,exchange_client,left"
        "SUPER+SHIFT,Right,exchange_client,right"
        "SUPER+SHIFT,Up,exchange_client,up"
        "SUPER+SHIFT,Down,exchange_client,down"
        # Multiple monitors: move the window / the focus to the neighbouring one
        "SUPER+ALT,Left,tagmon,left"
        "SUPER+ALT,Right,tagmon,right"
        "ALT+SHIFT,Left,focusmon,left"
        "ALT+SHIFT,Right,focusmon,right"
        "NONE,XF86AudioRaiseVolume,spawn,noctalia msg volume-up"
        "NONE,XF86AudioLowerVolume,spawn,noctalia msg volume-down"
        "NONE,XF86AudioMute,spawn,noctalia msg volume-mute"
        "NONE,XF86MonBrightnessUp,spawn,noctalia msg brightness-up"
        "NONE,XF86MonBrightnessDown,spawn,noctalia msg brightness-down"
      ]
      ++ lib.concatMap (
        n:
        let
          k = toString n;
        in
        [
          "SUPER,${k},view,${k},0"
          "SUPER+SHIFT,${k},tag,${k},0"
        ]
      ) (lib.range 1 9);
    };

    # Colors (borders, focus, urgent, ...) follow the wallpaper: Noctalia's
    # "mango" template writes them to ~/.config/mango/noctalia.conf and reloads
    # Mango. Its hook would append this line to config.conf, which Home Manager
    # links read-only, so it is set here (the hook finds it and skips). Before
    # Noctalia's first run the file is missing: Mango logs that and uses its
    # default colors. No color options in the settings above.
    extraConfig = ''
      source = ~/.config/mango/noctalia.conf
    '';
  };
}
